[Unit]
Description=PiStorm-Atari Emulator
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
# run-pistorm.sh starts ASTOS (when ./astos is built) and the builds it
# launches; without ASTOS it runs the setup page loop. An older copy of
# this file that runs ./emulator directly still ends up in ASTOS: the
# emulator hands a plain start to run-pistorm.sh when ./astos exists.
ExecStart=/bin/sh /home/pistorm/pistorm-atari-jit/run-pistorm.sh
WorkingDirectory=/home/pistorm/pistorm-atari-jit

[Install]
WantedBy=multi-user.target

