#**************************************************************************
# pistormsxb_devEPM240.sdc -- TimeQuest constraints, 2.0b fast-clock line
#
# Atari ST 8 MHz bus (period 125 ns). The 68000 bus cycle is 4 clock
# periods (S0..S7) and the state machine advances on BOTH clock edges,
# so the critical internal transfers are HALF-period (62.5 ns) paths.
# TimeQuest analyses posedge->negedge / negedge->posedge automatically
# once c8m is defined with a 50% waveform -- no extra constraint needed,
# but do check the "setup: c8m -> c8m" report shows 62.5 ns paths.
#**************************************************************************

# --- Primary clocks ------------------------------------------------------

# Atari 8 MHz system clock
create_clock -name c8m -period 125.000 -waveform {0.000 62.500} [get_ports {M68K_CLK}]

# Pi command-write strobe: both edges are used (posedge captures a0/op_*/
# status, negedge sets PI_TXN_IN_PROGRESS). Not periodic -- 100 ns is a
# conservative stand-in; real strobe spacing is far larger.
create_clock -name pi_wr -period 100.000 [get_ports {PI_CMD_WR}]

# 2.0b: GPCLK0 from the Pi on GPIO4 - 62.5 MHz (16 ns). Times the read
# release only (rd_p / rd_n sample s6|s7 on both edges).
create_clock -name pi_clk -period 16.000 -waveform {0.000 8.000} [get_ports {PI_CLK}]

# DTACK_n falling edge clocks the got_dtack catcher flop
create_clock -name dtack_clk -period 125.000 [get_ports {M68K_DTACK_n}]

# --- Generated clock: 68000 E (c8m / 10, six clocks low / four high) -----
# ECLOCK toggles on c8m FALLING edges: rise at source edge 2, fall 4 clock
# periods later (edge 10), next rise 10 periods after the first (edge 22).
create_generated_clock -name e_clk -source [get_ports {M68K_CLK}] \
    -edges {2 10 22} [get_registers {*e_clk|ECLOCK}]

derive_clock_uncertainty

# --- Clock-domain relationships ------------------------------------------
# pi_wr-domain registers (a0/op_*/halt/reset_*/TXN) are consumed in the c8m
# domain only after PI_TXN_IN_PROGRESS is seen; op_* were captured a full
# strobe-width earlier (WR rising edge vs TXN on the falling edge), so the
# crossing is safe by protocol and TXN itself is sampled by exactly one
# flop (AS_INT launch). Cut these paths.
# got_dtack (dtack_clk domain) feeds s5 alongside a direct !DTACK_n level
# term; that level path IS timed, via the set_input_delay below.
set_clock_groups -asynchronous \
    -group [get_clocks {c8m e_clk}] \
    -group [get_clocks {pi_wr}] \
    -group [get_clocks {dtack_clk}] \
    -group [get_clocks {pi_clk}]

# --- 68000 bus inputs (generated by GLUE/MMU/MFP from the same 8 MHz) -----
# 45 ns max external clock-to-valid leaves 17.5 ns for pin+logic+setup on
# the half-period edge relationship -- comfortable on an EPM240 (tSU few ns).
set_input_delay -clock c8m -max 45.0 [get_ports {M68K_DTACK_n M68K_BERR_n M68K_VPA_n M68K_IPL_n[*] M68K_BR_n M68K_BGACK_n}]
set_input_delay -clock c8m -min  5.0 [get_ports {M68K_DTACK_n M68K_BERR_n M68K_VPA_n M68K_IPL_n[*] M68K_BR_n M68K_BGACK_n}]

# --- 68000 bus outputs ----------------------------------------------------
# Downstream (GLUE/MMU) samples on the opposite c8m edge: 62.5 ns window.
# 15 ns output delay models trace + receiver setup; CPLD tCO must fit in
# the remaining 47.5 ns (typ. tCO on EPM240 is < 8 ns).
set_output_delay -clock c8m -max 15.0 [get_ports {M68K_AS_n M68K_UDS_n M68K_LDS_n M68K_RW M68K_FC[*] M68K_VMA_n M68K_BG_n}]
set_output_delay -clock c8m -min -5.0 [get_ports {M68K_AS_n M68K_UDS_n M68K_LDS_n M68K_RW M68K_FC[*] M68K_VMA_n M68K_BG_n}]

# Registered latch-control outputs (address/data latch OE + read-latch clocks)
set_output_delay -clock c8m -max 15.0 [get_ports {LTCH_A_OE_n LTCH_D_WR_OE_n LTCH_D_RD_U LTCH_D_RD_L}]
set_output_delay -clock c8m -min -5.0 [get_ports {LTCH_A_OE_n LTCH_D_WR_OE_n LTCH_D_RD_U LTCH_D_RD_L}]

# --- Pi interface ----------------------------------------------------------
# PI_D / PI_CMD setup+hold around the WR strobe (Pi sets data first, then
# raises WR in a separate GPIO write; holds past the falling edge).
set_input_delay -clock pi_wr -max 10.0 [get_ports {PI_D[*] PI_CMD[*]}]
set_input_delay -clock pi_wr -min  0.0 [get_ports {PI_D[*] PI_CMD[*]}]

# Combinational decode paths Pi strobes -> external 74LS latch clocks/OE:
# keep them tight so latch strobes track PI_CMD_WR/RD closely.
set_max_delay -from [get_ports {PI_CMD[*] PI_CMD_WR}] \
              -to   [get_ports {LTCH_A_0 LTCH_A_8 LTCH_A_16 LTCH_A_24 LTCH_D_WR_U LTCH_D_WR_L LTCH_D_RD_OE_n}] 15.0

# Combinational status readback (REG_STATUS + CMDRD -> PI_D tristate)
set_max_delay -from [get_ports {PI_CMD[*] PI_CMD_WR}] -to [get_ports {PI_D[*]}] 25.0

# Pi polls these asynchronously over GPIO -- no synchronous relationship
set_false_path -to [get_ports {PI_TXN_IN_PROGRESS PI_BERR PI_IPL1 PI_IPL2}]

# --- Miscellaneous ----------------------------------------------------------
# RESET / HALT: slow open-drain system lines, used as async preset/clear
# and re-synchronised internally (resetfilter) where a clean edge matters.
set_false_path -from [get_ports {M68K_RESET_n M68K_HALT_n}]
set_false_path -to   [get_ports {M68K_RESET_n M68K_HALT_n}]

# E output pin: 800 ns period, consumers handshake via VPA/VMA -- huge margin
set_false_path -to [get_ports {M68K_E}]
