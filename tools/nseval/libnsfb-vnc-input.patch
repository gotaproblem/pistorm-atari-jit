+/* Input from the VNC callbacks is queued: one rfbProcessEvents() call can
+ * deliver several pointer/key messages, and each must reach NetSurf. */
+#define VNC_EVQ_SIZE 256
+static nsfb_event_t vnc_evq[VNC_EVQ_SIZE];
+static unsigned int vnc_evq_head, vnc_evq_tail;
+
+static void vnc_evq_push(enum nsfb_event_type_e type, int code, int x, int y)
+{
+    nsfb_event_t *ev;
+
+    if (vnc_evq_tail - vnc_evq_head >= VNC_EVQ_SIZE)
+	return; /* full: drop */
+    ev = &vnc_evq[vnc_evq_tail++ % VNC_EVQ_SIZE];
+    ev->type = type;
+    if (type == NSFB_EVENT_MOVE_ABSOLUTE) {
+	ev->value.vector.x = x;
+	ev->value.vector.y = y;
+	ev->value.vector.z = 0;
+    } else {
+	ev->value.keycode = code;
+    }
+}
+
+static bool vnc_evq_pop(nsfb_event_t *event)
+{
+    if (vnc_evq_head == vnc_evq_tail)
+	return false;
+    *event = vnc_evq[vnc_evq_head++ % VNC_EVQ_SIZE];
+    return true;
+}
 
