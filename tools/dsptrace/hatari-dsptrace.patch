+/* PiStorm comparison trace (HATARI_DSPTRACE=<file>): the same events, in
+ * the same format, as the PiStorm emulator's PISTORM_DSP_TRACE dump, plus
+ * the 68k pc. Time is emulated (CPU cycles at 16 MHz). */
+static FILE *hdtr_f; static int hdtr_init; static unsigned hdtr_seq, hdtr_max;
+void hdtr(char t, uint32_t v, uint32_t x)
+{
+	if (!hdtr_init) {
+		const char *p = getenv("HATARI_DSPTRACE"), *m = getenv("HATARI_DSPTRACE_MAX");
+		hdtr_init = 1;
+		hdtr_max = m ? (unsigned)atol(m) : 50000000u;
+		if (p) { hdtr_f = fopen(p, "w"); if (hdtr_f) fprintf(hdtr_f, "# Hatari host-port trace\n#     seq        ms    frame t  value   x  dsp-pc  68k-pc\n"); }
+	}
+	if (!hdtr_f || hdtr_seq >= hdtr_max) return;
+	fprintf(hdtr_f, "%9u %9.3f %8u %c %06X %3u  %04X  %06X\n", hdtr_seq++,
+	        (double)CyclesGlobalClockCounter / 16000.0, (unsigned)nVBLs, t, v & 0xFFFFFF,
+	        x > 255 ? 255 : x, dsp_core.pc, (unsigned)(M68000_GetPC() & 0xFFFFFF));
+}
 
 /*--- the DSP core itself ---*/
 dsp_core_t dsp_core;
